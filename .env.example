APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# JST is the product's own clock: it is sold in Japan, and the host and MySQL
# are on Asia/Tokyo too, so nothing converts between a stored timestamp, NOW()
# and the date a shop owner reads. The scheduled tasks pin the zone themselves
# as well, so the hour they run at does not depend on this.
APP_TIMEZONE=Asia/Tokyo

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, not SQLite: the suite runs against stoc_meo_test to match the
# deployment, and TestCase fails the run if it finds itself anywhere else.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stoc_meo
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Horizon runs the queues, so this has to be redis. The supervisors are sized
# per queue in config/horizon.php; see .ai/rules/queues-and-schedule.md.
QUEUE_CONNECTION=redis

# CACHE_STORE, not CACHE_DRIVER. Laravel 11 renamed it and nothing reads the
# old name, so a .env still setting CACHE_DRIVER silently runs on the database
# store while looking like it is on Redis.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound mail goes through Resend's API, not SMTP. RESEND_API_KEY is the
# whole configuration — there is no host, port, or scheme to get wrong, and
# resend/resend-laravel registers the transport.
#
# The from address has to belong to a domain verified in the Resend dashboard.
# An unverified one is accepted by the API and then never delivered.
MAIL_MAILER=resend
MAIL_USERNAME=
MAIL_FROM_ADDRESS=info@stoc-plus.site
MAIL_FROM_NAME="STOC MEO"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe / Laravel Cashier. The billable is Organization, not User, and
# Cashier's own routes are ignored — bootstrap/app.php declares the webhook so
# it reaches this application's StripeWebhookController.
#
# STRIPE_WEBHOOK_SECRET is what the endpoint's signature is checked against.
# Without it Cashier skips VerifyWebhookSignature and the endpoint accepts any
# POST, so it is required in every environment that Stripe can reach.
# The endpoint must be subscribed to checkout.session.completed,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid and invoice.payment_failed.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja_JP

# DataForSEO supplies the local rank data. Sandbox answers with the same shape
# at no cost, but it authenticates with the same account: without a login and
# password it answers 401 and isAvailable() is false either way, which shows up
# as every rank row reading provider "fallback" with a null rank.
#
# The deployment runs with DATAFORSEO_SANDBOX=false and live credentials, so
# each keyword check is a billed call.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_SANDBOX=true

# Which market the SERP is asked for, and how deep. These decide what a rank
# means, so they belong with the credentials rather than in a default.
DATAFORSEO_LOCATION_NAME=Japan
DATAFORSEO_LANGUAGE_CODE=ja
DATAFORSEO_DEPTH=100
DATAFORSEO_TIMEOUT=30

# The map zoom a heatmap's grid points are searched at, which decides how much
# ground each of the 25 or 49 points sees.
DATAFORSEO_ZOOM=14

# Monthly PDF reports. Dompdf carries no Japanese glyphs of its own, so point
# REPORTS_FONT_PATH at a font that has them or the report's labels come out
# blank. It has to be a .ttf or .otf: Dompdf cannot read a .ttc collection,
# which rules out what fonts-noto-cjk installs. The path below is the
# fonts-vlgothic package.
REPORTS_DISK=reports
REPORTS_FONT_FAMILY="VL PGothic"
REPORTS_FONT_PATH=/usr/share/fonts/truetype/vlgothic/VL-PGothic-Regular.ttf

# Google Business Profile. The redirect URI has to match what is registered in
# the Google Cloud console exactly, including scheme and trailing slash.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# Anthropic Claude writes the review replies and campaign captions. The fast
# model does the short pieces; the strong one is there for work that needs more
# judgement. Model ids are exact and carry no date suffix.
#
# With no key the nightly ai:insights sweep still calculates the MEO scores and
# queues nothing that would call a model, so an unconfigured deployment does
# not fill failed_jobs.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_STRONG=claude-sonnet-4-6
AI_MAX_TOKENS=1024
AI_TIMEOUT=60

# Instagram publishing goes through Meta's Graph API. It needs an Instagram
# professional account linked to a Facebook page, and campaign images have to
# be at a URL Meta can fetch — it will not accept an upload.
INSTAGRAM_API_VERSION=v21.0
